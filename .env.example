# Database
DATABASE_URL=postgresql+asyncpg://proxy:proxy@postgres:5432/llmproxy

# Redis
REDIS_URL=redis://redis:6379/0

# JWT Authentication
JWT_SECRET=change-me-to-a-random-string

# Provider API Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ollama (local models)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Admin credentials (password is bcrypt hash)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$LJ3m4ys3Lk0TSwHCpNMQaOkVhOFOjH6MqtUxBGJCgQOh1Ax6vMwBm

# Logging
LOG_LEVEL=INFO
