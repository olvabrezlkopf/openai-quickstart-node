FROM node:20-alpine AS build

WORKDIR /app
COPY dashboard/package.json ./
RUN npm install
COPY dashboard/ .
RUN npm run build

FROM nginx:1.25-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx/dashboard.conf /etc/nginx/conf.d/default.conf
EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]
