# ─── APEX Trading System — Environment Variables ───────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Hyperliquid ─────────────────────────────────────────────────────────────
HL_PRIVATE_KEY=your_hyperliquid_private_key_here
HL_WALLET_ADDRESS=your_wallet_address_here
HL_TESTNET=true

# ─── LLM API Keys ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...        # https://openrouter.ai — needed for Mistral debate model
GOOGLE_API_KEY=AIza...              # Google AI Studio — needed for Gemini debate model

# ─── Telegram Bot ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-...
TELEGRAM_CHAT_ID=your_chat_id

# ─── Sentiment Sources ───────────────────────────────────────────────────────
CRYPTOPANIC_API_KEY=your_key_here   # https://cryptopanic.com/developers/api/
# Reddit — uses public API, no key needed
# FinancialJuice — RSS feed, no key needed

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_PATH=./apex.db

# ─── Tax Export ──────────────────────────────────────────────────────────────
TAX_EXPORT_PATH=./exports/

# ─── Server ──────────────────────────────────────────────────────────────────
API_PORT=8000
WATCHDOG_PORT=8001
CORS_ORIGINS=http://localhost:5173,https://your-domain.com
